%% =========================================================
%  全球SST Mean State & Variability: High minus Low
%  基于各关键区31yr non-overlapping窗口 VARIABILITY 分组
%  variability = 850-1850气候态为背景的SST距平，31yr窗口内的std
%  （IOD、SASD例外，用距平差值的31yr std，反映偶极子强度的变率）
%  同时输出：高-低 variability 时期，全球SST mean state diff 和
%            全球SST variability diff
%  指数：Nino3.4, TNA, IOB, IOD, PDO, AMO, ATL3, SASD
%  4行2列，只画 High minus Low
% =========================================================
clear; clc;
%% ===== PART 1: COMPUTATION =================================
%% ---- (1) 加载数据 ------------------------------------------
load('C:\Users\yingy\Downloads\Data\Paleo3bs_Project\uv_sst_LME_15ens\iLME_full_ts_mme.mat', ...
     'ts_per_fl','lat_af','lon_af');
[nlat, nlon, nmon, nens] = size(ts_per_fl);
nyear = nmon / 12;
%% ---- (2) 面积权重 ------------------------------------------
reso_lat = 1.875; reso_lon = 2.5;
lat_vec = 90 - reso_lat/2 : -reso_lat : -90 + reso_lat/2;
lon_vec = -180 + reso_lon/2 : reso_lon : 180 - reso_lon/2;
[~, glat] = meshgrid(lon_vec, lat_vec);
area_weight = cosd(glat);
sst_last = squeeze(mean(ts_per_fl(:,:,end,:), 4, 'omitnan'));
ocean_mask = ~isnan(sst_last);
area_weight(~ocean_mask) = NaN;
%% ---- (3) 定义关键区 ----------------------------------------
regions_raw = {
    'Nino3.4',  46:51,   5:24;
    'TNA',      36:46,  51:66;
    'IOB',      38:70,  89:116;
    'WTIO',     44:53,  93:100;
    'ETIO',     49:53, 109:116;
    'PDO',      11:38, [117:144, 1:9];
    'AMO',      17:48,  41:72;
    'ATL3',     47:50,  65:72;
    'SASD_SW',  64:69,  61:68;
    'SASD_NE',  57:62,  65:72;
};
nreg_raw = size(regions_raw, 1);
idx_names = {'Nino3.4','TNA','IOB','IOD','PDO','AMO','ATL3','SASD'};
nreg = length(idx_names);
%% ---- (4) 各关键区逐月面积加权时间序列 ----------------------
fprintf('Computing regional monthly series...\n');
reg_mon_raw = nan(nmon, nens, nreg_raw);
for ireg = 1:nreg_raw
    lat_idx = regions_raw{ireg, 2};
    lon_idx = regions_raw{ireg, 3};
    w       = area_weight(lat_idx, lon_idx);
    w_sum   = nansum(w(:));
    for iens = 1:nens
        for im = 1:nmon
            slab = double(ts_per_fl(lat_idx, lon_idx, im, iens));
            reg_mon_raw(im, iens, ireg) = nansum(slab(:) .* w(:)) / w_sum;
        end
    end
    fprintf('  %d/%d (%s) done\n', ireg, nreg_raw, regions_raw{ireg,1});
end
%% ---- (5) 矩阵运算去除季节循环（基于850-1850气候态）--------
reg_mon_re   = reshape(reg_mon_raw, 12, nyear, nens, nreg_raw);
reg_clim     = nanmean(reg_mon_re(:, 1:1001, :, :), 2);
reg_clim_rep = repmat(reg_clim, 1, nyear, 1, 1);
reg_ano_re   = reg_mon_re - reg_clim_rep;
% 年均距平 [nyear x nens x nreg_raw] — 用于variability计算
reg_ano_annual_raw = squeeze(nanmean(reg_ano_re, 1));
% 年均绝对SST [nyear x nens x nreg_raw]
reg_sst_annual_raw = squeeze(nanmean(reg_mon_re, 1));
clear reg_mon_raw reg_mon_re reg_clim reg_clim_rep reg_ano_re
fprintf('Regional anomalies done.\n');
%% ---- (5b) 合并IOD和SASD ------------------------------------
reg_ano_annual = nan(nyear, nens, nreg);
reg_sst_annual = nan(nyear, nens, nreg);   % 绝对SST（差值型指数=距平差值）
for k = 1:3
    reg_ano_annual(:,:,k) = reg_ano_annual_raw(:,:,k);
    reg_sst_annual(:,:,k) = reg_sst_annual_raw(:,:,k);
end
% IOD = WTIO(4) - ETIO(5)，用距平差值（偶极子强度，无绝对量意义）
reg_ano_annual(:,:,4) = reg_ano_annual_raw(:,:,4) - reg_ano_annual_raw(:,:,5);
reg_sst_annual(:,:,4) = reg_ano_annual_raw(:,:,4) - reg_ano_annual_raw(:,:,5);
% PDO(6)->5, AMO(7)->6, ATL3(8)->7
for k = 5:7
    reg_ano_annual(:,:,k) = reg_ano_annual_raw(:,:,k+1);
    reg_sst_annual(:,:,k) = reg_sst_annual_raw(:,:,k+1);
end
% SASD = SW(9) - NE(10)，用距平差值（偶极子强度，无绝对量意义）
reg_ano_annual(:,:,8) = reg_ano_annual_raw(:,:,9) - reg_ano_annual_raw(:,:,10);
reg_sst_annual(:,:,8) = reg_ano_annual_raw(:,:,9) - reg_ano_annual_raw(:,:,10);
clear reg_ano_annual_raw reg_sst_annual_raw
% 说明：reg_clim 对每个(iens,ireg)在窗口内是常数，减去常数不改变std，
% 所以 std(reg_sst_annual) 与 std(reg_ano_annual) 在任意窗口内完全等价，
% 用 reg_sst_annual 统一计算每个指数的窗口内variability即可。
%% ---- (6) 全局SST年均距平（基于850-1850气候态）-------------
fprintf('Computing global SST anomalies...\n');
sst_mon_re   = reshape(ts_per_fl, nlat, nlon, 12, nyear, nens);
sst_clim     = nanmean(sst_mon_re(:,:,:,1:1001,:), 4);
sst_clim_rep = repmat(sst_clim, 1, 1, 1, nyear, 1);
sst_ano_re   = sst_mon_re - sst_clim_rep;
clear ts_per_fl sst_mon_re sst_clim sst_clim_rep
sst_ano_annual = squeeze(nanmean(sst_ano_re, 3));   % [nlat x nlon x nyear x nens]
clear sst_ano_re
fprintf('Global SST anomalies done.\n');
%% ---- (7) Non-overlapping 31yr 窗口 -------------------------
% 每个窗口同时算出：
%   reg_win_var  — 每个指数自身在该窗口内的variability（std），用于分组
%   sst_win_mean — 全局SST在该窗口内的mean state（距平均值）
%   sst_win_var  — 全局SST在该窗口内的variability（距平std）
nyear_clim = 1001;
win_size   = 31;
nwin       = floor(nyear_clim / win_size);
fprintf('Non-overlapping windows: %d\n', nwin);
reg_win_var  = nan(nwin, nens, nreg);
sst_win_mean = nan(nlat, nlon, nwin, nens, 'single');
sst_win_var  = nan(nlat, nlon, nwin, nens, 'single');
for iens = 1:nens
    for iw = 1:nwin
        yr_s = (iw-1)*win_size + 1;
        yr_e = iw * win_size;
        for ireg = 1:nreg
            % 分组依据：该指数自身在这个31yr窗口内的variability(std)
            reg_win_var(iw, iens, ireg) = std(reg_sst_annual(yr_s:yr_e, iens, ireg), 'omitnan');
        end
        sst_win_mean(:,:,iw,iens) = mean(sst_ano_annual(:,:,yr_s:yr_e,iens), 3, 'omitnan');
        sst_win_var(:,:,iw,iens)  = std( sst_ano_annual(:,:,yr_s:yr_e,iens), 0, 3, 'omitnan');
    end
    fprintf('  ens %d/%d done\n', iens, nens);
end
clear sst_ano_annual reg_ano_annual reg_sst_annual
%% ---- (8) 对每个关键区计算 High-Low VARIABILITY 分组下的
%          全球SST mean state / variability diff -------------
fprintf('Computing High-Low (by variability) diffs...\n');
sst_mean_diff_all = nan(nlat, nlon, nreg, 'single');
sst_var_diff_all  = nan(nlat, nlon, nreg, 'single');
sig_mean_diff_all = false(nlat, nlon, nreg);
sig_var_diff_all  = false(nlat, nlon, nreg);
for ireg = 1:nreg
    fprintf('  Region %d/%d (%s)...\n', ireg, nreg, idx_names{ireg});
    idx_vals  = reg_win_var(:,:,ireg);
    idx_all   = idx_vals(~isnan(idx_vals(:)));
    idx_avg   = mean(idx_all, 'omitnan');
    idx_std   = std(idx_all,  'omitnan');
    thresh_hi = idx_avg + 0.5*idx_std;
    thresh_lw = idx_avg - 0.5*idx_std;
    fprintf('    mean=%.4f std=%.4f hi>%.4f lw<%.4f\n', ...
            idx_avg, idx_std, thresh_hi, thresh_lw);

    hi_mean_samps = []; lw_mean_samps = [];
    hi_var_samps  = []; lw_var_samps  = [];
    for iens = 1:nens
        for iw = 1:nwin
            v = reg_win_var(iw, iens, ireg);
            if isnan(v); continue; end
            if v > thresh_hi
                hi_mean_samps = cat(3, hi_mean_samps, sst_win_mean(:,:,iw,iens));
                hi_var_samps  = cat(3, hi_var_samps,  sst_win_var(:,:,iw,iens));
            elseif v < thresh_lw
                lw_mean_samps = cat(3, lw_mean_samps, sst_win_mean(:,:,iw,iens));
                lw_var_samps  = cat(3, lw_var_samps,  sst_win_var(:,:,iw,iens));
            end
        end
    end
    n_hi = size(hi_mean_samps, 3);
    n_lw = size(lw_mean_samps, 3);
    fprintf('    n_hi=%d  n_lw=%d\n', n_hi, n_lw);

    hi_md = double(hi_mean_samps); lw_md = double(lw_mean_samps);
    sst_mean_diff_all(:,:,ireg) = single(mean(hi_md,3,'omitnan') - mean(lw_md,3,'omitnan'));

    hi_vd = double(hi_var_samps);  lw_vd = double(lw_var_samps);
    sst_var_diff_all(:,:,ireg)  = single(mean(hi_vd,3,'omitnan') - mean(lw_vd,3,'omitnan'));

    % 显著性：ttest2
    for ilat = 1:nlat
        for ilon = 1:nlon
            v1 = squeeze(hi_md(ilat,ilon,:)); v1(isnan(v1)) = [];
            v2 = squeeze(lw_md(ilat,ilon,:)); v2(isnan(v2)) = [];
            if length(v1)>=3 && length(v2)>=3
                [~,p] = ttest2(v1,v2);
                if p < 0.05; sig_mean_diff_all(ilat,ilon,ireg) = true; end
            end
            v1 = squeeze(hi_vd(ilat,ilon,:)); v1(isnan(v1)) = [];
            v2 = squeeze(lw_vd(ilat,ilon,:)); v2(isnan(v2)) = [];
            if length(v1)>=3 && length(v2)>=3
                [~,p] = ttest2(v1,v2);
                if p < 0.05; sig_var_diff_all(ilat,ilon,ireg) = true; end
            end
        end
    end
end
save('GlobalSST_MeanState_Var_AllRegions_HighLow_v2.mat', ...
     'sst_mean_diff_all','sst_var_diff_all', ...
     'sig_mean_diff_all','sig_var_diff_all', ...
     'idx_names','nreg','lat_af','lon_af');
fprintf('Saved: GlobalSST_MeanState_Var_AllRegions_HighLow_v2.mat\n');
fprintf('Computation done.\n');

%% ===== PART 2: PLOTTING ====================================
clear; clc;
load('GlobalSST_MeanState_Var_AllRegions_HighLow_v2.mat');
load('BlueWhiteOrangeRed.mat');
cmap_use  = BlueWhiteOrangeRed;
n_idx     = length(idx_names);   % = 8, 顺序须与 idx_names 完全一致：
                                  % Nino3.4, TNA, IOB, IOD, PDO, AMO, ATL3, SASD
%% ---- Grid -------------------------------------------------
lon_orig = lon_af(:)';
lat_orig = lat_af(:)';
nlon     = length(lon_orig);
%% ---- Pacific-centered -------------------------------------
lon_cut = 20;
idx_R   = find(lon_orig >= lon_cut);
idx_L   = find(lon_orig <  lon_cut);
lon_pc  = [lon_orig(idx_R), lon_orig(idx_L)+360];
reorder = @(F) F(:,[idx_R, idx_L]);
%% ---- Land mask --------------------------------------------
fprintf('Building land mask...\n');
shp_path = 'C:\Users\yingy\Downloads\D\FengYingying\FengYingyingData\MapData\GLOBALSHP\ContinentsPoly.shp';
S = shaperead(shp_path, 'UseGeoCoords', true);
[LON_orig, LAT_orig] = meshgrid(lon_orig, lat_orig);
land_orig = false(size(LON_orig));
for ipoly = 1:length(S)
    px = S(ipoly).Lon(:); py = S(ipoly).Lat(:);
    if isempty(px); continue; end
    nan_idx = find(isnan(px)); nan_idx = nan_idx(:);
    seg_s = [1; nan_idx+1]; seg_e = [nan_idx-1; length(px)];
    for iseg = 1:length(seg_s)
        s = seg_s(iseg); e = seg_e(iseg);
        if e-s < 2; continue; end
        in = inpolygon(LON_orig(:), LAT_orig(:), px(s:e), py(s:e));
        land_orig = land_orig | reshape(in, size(LON_orig));
    end
end
fprintf('Land mask done.\n');
%% ---- Lat restriction --------------------------------------
lat_min = -60; lat_max = 60;
lat_idx = lat_orig >= lat_min & lat_orig <= lat_max;
lat_use = lat_orig(lat_idx);
nlat_sub = sum(lat_idx);
%% ---- Significance dot grid --------------------------------
dot_lons_base = lon_cut:5:lon_cut+355;
dot_lats_base = lat_min:5:lat_max;
[dLON, dLAT]  = meshgrid(dot_lons_base, dot_lats_base);
dot_lon_pc_vec = dLON(:);
dot_lat_vec    = dLAT(:);
dot_lat_gidx   = nan(size(dot_lat_vec));
dot_lon_pc_idx = nan(size(dot_lon_pc_vec));
for k = 1:length(dot_lat_vec)
    [~, dot_lat_gidx(k)]   = min(abs(lat_use - dot_lat_vec(k)));
    [~, dot_lon_pc_idx(k)] = min(abs(lon_pc  - dot_lon_pc_vec(k)));
end
%% ---- X/Y tick labels --------------------------------------
xtick_vals_pc = [60, 120, 180, 240, 300];
xtick_labels  = {'60E','120E','180','120W','60W'};
ytick_labels  = {'60S','30S','0','30N','60N'};
%% ---- Common style -----------------------------------------
white_rgb = [1.0  1.0  1.0];   % 陆地白色
grey_rgb  = [0.75 0.75 0.75];  % 海洋NaN背景
green_rgb = [0.0  0.55 0.0 ];
clim_mean = [-0.30  0.30];
clim_var  = [-0.15  0.15];
%% ---- 画布布局：4行2列，真实经纬度比例 ----------------------
% 经度360°，纬度120°（-60到60），等距投影比例 = 120/360 = 1/3
page_width  = 18;   % cm
ncol = 2; nrow = 4;
xstart = 0.08;
epsw   = 0.06;   % 列间距（归一化）
epsh   = 0.03;   % 行间距（归一化）
% panel归一化宽度
width = (1 - xstart - 0.03 - epsw) / ncol;
% panel高度：严格按 lat_range/lon_range 等距比例，保证地图不失真
lat_range = lat_max - lat_min;   % 120
lon_range = 360;
panel_cm_w = page_width * width;
panel_cm_h = panel_cm_w * (lat_range / lon_range);
% ---- 页面长宽比 1:1.5（page_height = page_width * 1.5）----
cb_area_cm   = 1.5;    % 色标区域高度(cm)
top_margin   = 1;      % 顶部标题区(cm)
bottom_margin= 0.8;    % 底部基础边距(cm)
min_needed_height = nrow * panel_cm_h + (nrow-1) * epsh * page_width + ...
                     cb_area_cm + top_margin + bottom_margin;
page_height = page_width * 1.5;   % 目标：宽:高 = 1:1.5
% 多余空间全部放到底部（增大 bottom_margin），保持地图真实比例不变
extra_h       = max(page_height - min_needed_height, 0);
bottom_margin = bottom_margin + extra_h;
% 归一化高度
height_norm  = panel_cm_h / page_height;
epsh_norm    = epsh * page_width / page_height;
% 色标归一化位置
cb_h_norm    = 0.012 * page_width / page_height;
cb_bot_norm  = (bottom_margin - 0.3) / page_height;
cb_gap_norm  = 0.008;
cb_w         = width * ncol + epsw;
cb_pos       = [xstart, cb_bot_norm, cb_w, cb_h_norm];
ystart_norm  = cb_bot_norm + cb_h_norm + cb_gap_norm * 3;
% panel位置（从下到上：r=4是第1行显示，r=1是最后行）
pos = zeros(nrow*ncol, 4);
for r = 1:nrow
    for c = 1:ncol
        pos((r-1)*ncol+c, 1) = xstart + (c-1)*(width + epsw);
        pos((r-1)*ncol+c, 2) = ystart_norm + (nrow-r)*(height_norm + epsh_norm);
        pos((r-1)*ncol+c, 3) = width;
        pos((r-1)*ncol+c, 4) = height_norm;
    end
end
% ---- panel标签：顺序须与 idx_names 一一对应 -----------------
% idx_names = {'Nino3.4','TNA','IOB','IOD','PDO','AMO','ATL3','SASD'}
panel_labels = {'(a) Nino3.4', '(b) TNA', ...
                 '(c) IOB',     '(d) IOD', ...
                 '(e) PDO',     '(f) AMO', ...
                 '(g) ATL3',    '(h) SASD'};
assert(isequal(idx_names, {'Nino3.4','TNA','IOB','IOD','PDO','AMO','ATL3','SASD'}), ...
       'idx_names 顺序与 panel_labels 不一致，请检查 GlobalSST_MeanState_Var_AllRegions_HighLow_v2.mat！');
%% ============================================================
%  图1：Mean State diff（High minus Low VARIABILITY epoch 的 ΔSST 距平）
%% ============================================================
hfig1 = figure('Units','centimeters', ...
    'Position',[0 0 page_width page_height], ...
    'PaperPosition',[0 0 page_width page_height], ...
    'Color',[1 1 1]);
top_y = pos(1,2) + height_norm + epsh_norm * 0.3;
annotation('textbox',[xstart, top_y, cb_w, 0.06], ...
    'String','High minus Low Variability Period — \DeltaSST Mean State', ...
    'FontName','Helvetica','FontSize',13,'FontWeight','bold', ...
    'Color','k','HorizontalAlignment','center', ...
    'VerticalAlignment','bottom','EdgeColor','none', ...
    'FitBoxToText','off','Interpreter','tex');
for ip = 1:n_idx
    dat_pc  = reorder(sst_mean_diff_all(lat_idx,:,ip));
    sig_pc  = reorder(sig_mean_diff_all(lat_idx,:,ip));
    land_pc = reorder(land_orig(lat_idx,:));
    row_ip    = ceil(ip/ncol);
    show_xlab = (row_ip == nrow);
    ax = axes('Position', pos(ip,:));
    draw_panel(ax, dat_pc, sig_pc, land_pc, lon_pc, lat_use, ...
               clim_mean, cmap_use, lon_cut, lat_min, lat_max, ...
               xtick_vals_pc, xtick_labels, ytick_labels, show_xlab, ...
               white_rgb, grey_rgb, green_rgb, nlat_sub, ...
               dot_lat_gidx, dot_lon_pc_idx, dot_lat_vec, nlon, S);
    % ---- 标签画在panel方框正上方，顺序对应 idx_names{ip} ----
    annotation(hfig1, 'textbox', ...
               [pos(ip,1), ...
                pos(ip,2) + height_norm + 0.003, ...
                0.18, 0.018], ...
        'String', panel_labels{ip}, ...
        'FontName','Helvetica','FontSize',10,'FontWeight','bold', ...
        'Color','k','HorizontalAlignment','left', ...
        'VerticalAlignment','bottom','EdgeColor','none', ...
        'FitBoxToText','off','Interpreter','none');
    axes('Position',ax.Position,'box','on','ytick',[],'xtick',[],'color','none');
end
ax_cb1 = axes('Position',[0 0 1 1], 'Visible','off');
colormap(ax_cb1, cmap_use);
caxis(ax_cb1, clim_mean);
cb1 = colorbar(ax_cb1, 'Location','southoutside', 'Position', cb_pos);
set(cb1, 'Ticks',-0.3:0.1:0.3, 'TickLength',0.003, ...
    'FontSize',10, 'FontName','Helvetica', 'LineWidth',0.8);
xlabel(cb1, '\DeltaSST anomaly (^{\circ}C)', ...
    'FontName','Helvetica', 'FontSize',10);
print(hfig1, '-dtiff', '-r600', './GlobalSST_MeanState_AllRegions_HighLow_v2.tif');
fprintf('Saved: GlobalSST_MeanState_AllRegions_HighLow_v2.tif\n');
%% ============================================================
%  图2：Variability diff（High minus Low VARIABILITY epoch 的 ΔSST std）
%% ============================================================
hfig2 = figure('Units','centimeters', ...
    'Position',[0 0 page_width page_height], ...
    'PaperPosition',[0 0 page_width page_height], ...
    'Color',[1 1 1]);
top_y = pos(1,2) + height_norm + epsh_norm * 0.3;
annotation('textbox',[xstart, top_y, cb_w, 0.06], ...
    'String','High minus Low Variability Period — \DeltaSST Variability', ...
    'FontName','Helvetica','FontSize',13,'FontWeight','bold', ...
    'Color','k','HorizontalAlignment','center', ...
    'VerticalAlignment','bottom','EdgeColor','none', ...
    'FitBoxToText','off','Interpreter','tex');
for ip = 1:n_idx
    dat_pc  = reorder(sst_var_diff_all(lat_idx,:,ip));
    sig_pc  = reorder(sig_var_diff_all(lat_idx,:,ip));
    land_pc = reorder(land_orig(lat_idx,:));
    row_ip    = ceil(ip/ncol);
    show_xlab = (row_ip == nrow);
    ax = axes('Position', pos(ip,:));
    draw_panel(ax, dat_pc, sig_pc, land_pc, lon_pc, lat_use, ...
               clim_var, cmap_use, lon_cut, lat_min, lat_max, ...
               xtick_vals_pc, xtick_labels, ytick_labels, show_xlab, ...
               white_rgb, grey_rgb, green_rgb, nlat_sub, ...
               dot_lat_gidx, dot_lon_pc_idx, dot_lat_vec, nlon, S);
    % ---- 标签画在panel方框正上方，顺序对应 idx_names{ip} ----
    annotation(hfig2, 'textbox', ...
               [pos(ip,1), ...
                pos(ip,2) + height_norm + 0.003, ...
                0.18, 0.018], ...
        'String', panel_labels{ip}, ...
        'FontName','Helvetica','FontSize',10,'FontWeight','bold', ...
        'Color','k','HorizontalAlignment','left', ...
        'VerticalAlignment','bottom','EdgeColor','none', ...
        'FitBoxToText','off','Interpreter','none');
    axes('Position',ax.Position,'box','on','ytick',[],'xtick',[],'color','none');
end
ax_cb2 = axes('Position',[0 0 1 1], 'Visible','off');
colormap(ax_cb2, cmap_use);
caxis(ax_cb2, clim_var);
cb2 = colorbar(ax_cb2, 'Location','southoutside', 'Position', cb_pos);
set(cb2, 'Ticks',-0.15:0.05:0.15, 'TickLength',0.003, ...
    'FontSize',10, 'FontName','Helvetica', 'LineWidth',0.8);
xlabel(cb2, '\DeltaSST variability (^{\circ}C)', ...
    'FontName','Helvetica', 'FontSize',10);
print(hfig2, '-dtiff', '-r600', './GlobalSST_Var_AllRegions_HighLow_v4.tif');
fprintf('Saved: GlobalSST_Var_AllRegions_HighLow_v4.tif\n');
%% =========================================================
%  LOCAL FUNCTION
%% =========================================================
function draw_panel(ax, dat_pc, sig_pc, land_pc, lon_pc, lat_use, ...
                    clim_use, cmap_use, lon_cut, lat_min, lat_max, ...
                    xtick_vals, xtick_labels, ytick_labels, show_xlab, ...
                    white_rgb, grey_rgb, green_rgb, nlat_sub, ...
                    dot_lat_gidx, dot_lon_pc_idx, dot_lat_vec, nlon, S)
    % 背景色（NaN海洋区域）
    set(ax, 'Color', grey_rgb);
    % 画海洋数据
    dat_plot = dat_pc;
    dat_plot(land_pc) = NaN;
    imagesc(ax, lon_pc, lat_use, dat_plot);
    hold(ax, 'on');
    % 陆地白色覆盖层
    land_img = cat(3, ...
        white_rgb(1) * ones(size(land_pc)), ...
        white_rgb(2) * ones(size(land_pc)), ...
        white_rgb(3) * ones(size(land_pc)));
    hi_land = imagesc(ax, lon_pc, lat_use, land_img);
    set(hi_land, 'AlphaData', double(land_pc));
    set(ax, 'YDir','normal');
    colormap(ax, cmap_use);
    caxis(ax, clim_use);
    % 真实经纬度等距比例
    set(ax, 'DataAspectRatio', [1 1 1]);
    set(ax, 'XLim',[lon_cut lon_cut+360], 'YLim',[lat_min lat_max], ...
        'XTick',xtick_vals, 'YTick',[-60 -30 0 30 60], ...
        'TickDir','out', 'TickLength',[0.004 0], ...
        'FontName','Helvetica', 'FontSize',9, ...
        'Layer','top', 'LineWidth',0.8);
    if show_xlab
        set(ax, 'XTickLabel', xtick_labels);
    else
        set(ax, 'XTickLabel', []);
    end
    set(ax, 'YTickLabel', ytick_labels);
    box(ax, 'on');
    % 显著性点
    for k = 1:length(dot_lat_vec)
        ilat_g = dot_lat_gidx(k);
        ilon_g = dot_lon_pc_idx(k);
        if ilat_g < 1 || ilat_g > nlat_sub; continue; end
        if ilon_g < 1 || ilon_g > nlon;      continue; end
        if sig_pc(ilat_g,ilon_g) && ~land_pc(ilat_g,ilon_g)
            plot(ax, lon_pc(ilon_g), lat_use(ilat_g), '.', ...
                'Color', green_rgb, 'MarkerSize', 4);
        end
    end
    % 海岸线
    for ipoly = 1:length(S)
        px = S(ipoly).Lon(:); py = S(ipoly).Lat(:);
        if isempty(px); continue; end
        py(py < lat_min | py > lat_max) = NaN;
        for lon_shift = [0, 360]
            px_s = px + lon_shift;
            in_range = px_s >= lon_cut & px_s <= lon_cut+360;
            px_s(~in_range & ~isnan(px_s)) = NaN;
            if any(~isnan(px_s) & ~isnan(py))
                plot(ax, px_s, py, '-', 'Color',[0.25 0.25 0.25], 'LineWidth',0.5);
            end
        end
    end
end
