%% =========================================================
%  高 vs 低 SST Variability 时期：ENSO->TNA Interaction Strength
%  （Granger G-causality）分布密度图
%  沿用你 variability 脚本的 8 个指数 + 31yr non-overlapping 窗口，
%  沿用 Granger causality 脚本的 win_centers 与 R_Nino2TNA
% =========================================================
clear; clc;
%% ---- (1) 读取 variability window 统计（来自你的variability脚本）----
% 需要先跑完你的variability脚本 Part1，save出 WindowStats_Var_8idx_v1.mat
load('WindowStats_Var_8idx_v1.mat', ...
     'idx_win_var','idx_names','nwin','nens','n_idx', ...
     'win_size','nyear_clim');
% idx_win_var: [nwin x nens x n_idx]，nwin=32, win_size=31
% idx_names = {'Nino3.4','TNA','IOB','IOD','PDO','AMO','ATL3','SASD'}
%% ---- (2) 读取 Granger causality (ENSO->TNA) --------------------
load('Granger_NINOTNA_30yr.mat');    % 含 F21 [1156 x 15]（年 x ens）
R_Nino2TNA = F21;
clear F21
%% ---- (3) window centers，须与 idx_win_var 的窗口一一对应 -------
win_centers = 16 : win_size : (win_size*nwin);
if length(win_centers) ~= nwin
    error('win_centers 长度(%d)与 nwin(%d)不一致，请检查两段代码窗口定义是否匹配！', ...
          length(win_centers), nwin);
end
%% ---- (4) 提取每个窗口/集合成员对应的 G-causality 值 ------------
G_win = nan(nwin, nens);
for iw = 1:nwin
    ic = win_centers(iw);
    G_win(iw, :) = R_Nino2TNA(ic, :);
end
%% ---- (5) 对每个指数：按其31yr variability阈值，把对应窗口的
%          G-causality 分到 High / Low 两组 ------------------------
fprintf('Computing High/Low G-causality distributions (by variability)...\n');
Hi_G  = cell(n_idx,1);
Lo_G  = cell(n_idx,1);
p_ks  = nan(n_idx,1);
for i_idx = 1:n_idx
    idx_vals  = idx_win_var(:,:,i_idx);
    idx_all   = idx_vals(~isnan(idx_vals(:)));
    idx_avg   = mean(idx_all, 'omitnan');
    idx_std   = std(idx_all,  'omitnan');
    thresh_hi = idx_avg + 0.5*idx_std;
    thresh_lw = idx_avg - 0.5*idx_std;
    hi_samps = []; lo_samps = [];
    for iens = 1:nens
        for iw = 1:nwin
            v = idx_win_var(iw, iens, i_idx);
            g = G_win(iw, iens);
            if isnan(v) || isnan(g); continue; end
            if v > thresh_hi
                hi_samps(end+1,1) = g; %#ok<AGROW>
            elseif v < thresh_lw
                lo_samps(end+1,1) = g; %#ok<AGROW>
            end
        end
    end
    Hi_G{i_idx} = hi_samps;
    Lo_G{i_idx} = lo_samps;
    if numel(hi_samps) >= 5 && numel(lo_samps) >= 5
        [~, p_ks(i_idx)] = kstest2(hi_samps, lo_samps);
    end
    fprintf('  %d/%d (%-8s) n_hi=%-5d n_lo=%-5d  p=%.4f\n', ...
            i_idx, n_idx, idx_names{i_idx}, ...
            numel(hi_samps), numel(lo_samps), p_ks(i_idx));
end
save('GcausalityDist_Var_8idx_v1.mat', ...
     'Hi_G','Lo_G','p_ks','idx_names','n_idx');
fprintf('Saved: GcausalityDist_Var_8idx_v1.mat\n');
%% =========================================================
%  PLOT: 4行2列，8个panel，High/Low密度曲线叠加
% =========================================================
colors_hi = [0.00 0.00 0.00;   % 1 Nino3.4 - 黑
             0.90 0.55 0.10;   % 2 TNA     - 橙
             0.10 0.40 0.85;   % 3 IOB     - 蓝
             0.70 0.10 0.35;   % 4 IOD     - 洋红
             0.15 0.55 0.55;   % 5 PDO     - 青
             0.55 0.15 0.05;   % 6 AMO     - 深红/棕
             0.20 0.55 0.20;   % 7 ATL3    - 绿
             0.40 0.20 0.60];  % 8 SASD    - 紫
colors_lo = min(colors_hi + 0.45, 1);
x_grid = linspace(0, 0.2, 200);
hfig = figure('Units','centimeters', ...
    'Position',[0 0 18 22], ...
    'PaperPosition',[0 0 18 22], ...
    'Color',[1 1 1]);
nrow = 4; ncol = 2;
xstart = 0.10; ystart = 0.06;
width  = 0.40; height = 0.20;
epsw   = 0.06; epsh   = 0.02;
panel_letters = {'a','b','c','d','e','f','g','h'};

% ---- legend / p 值文本 相对该 panel 自身宽高的比例（可按需微调） ----
leg_w_ax = 0.42;   % legend 宽度，占该 axes 宽度的比例
leg_h_ax = 0.16;   % legend 高度，占该 axes 高度的比例
leg_x_ax = 1 - leg_w_ax - 0.03;   % legend 右边距 axes 右边界 0.03
leg_y_ax = 1 - leg_h_ax - 0.03;   % legend 上边距 axes 顶边界 0.03

for i_idx = 1:n_idx
    row = mod(i_idx-1, nrow) + 1;   % a-d放左列, e-h放右列
    col = ceil(i_idx / nrow);
    pos = [xstart + (col-1)*(width+epsw), ...
           ystart + (nrow-row)*(height+epsh), ...
           width, height];
    ax = axes('Position', pos); hold(ax,'on');
    hi_samps = Hi_G{i_idx};
    lo_samps = Lo_G{i_idx};
    if numel(hi_samps) >= 5
        [f_hi, xi_hi] = ksdensity(hi_samps, x_grid, 'Support','positive');
        plot(ax, xi_hi, f_hi, '-', 'Color', colors_hi(i_idx,:), 'LineWidth', 2);
    end
    if numel(lo_samps) >= 5
        [f_lo, xi_lo] = ksdensity(lo_samps, x_grid, 'Support','positive');
        plot(ax, xi_lo, f_lo, '-', 'Color', colors_lo(i_idx,:), 'LineWidth', 2);
    end
    xlim(ax, [0 0.2]); ylim(ax, [0 30]);
    set(ax, 'FontName','Helvetica', 'FontSize',10, 'Box','on', ...
        'TickDir','out', 'LineWidth',0.8);
    if row == nrow
        xlabel(ax, 'G-causality', 'FontSize',11);
    else
        set(ax, 'XTickLabel', []);
    end
    if col == 1
        ylabel(ax, 'Density', 'FontSize',11);
    end
    text(ax, 0.03, 0.95, sprintf('\\bf %s', panel_letters{i_idx}), ...
        'Units','normalized', 'FontSize',12, 'VerticalAlignment','top');

    % ---- legend：用 pos 手动算出 figure-normalized 位置并指定，
    %      不依赖 drawnow / 自动布局的时机，位置完全确定，不会跑偏 ----
    leg_pos_fig = [pos(1) + leg_x_ax*pos(3), ...
                   pos(2) + leg_y_ax*pos(4), ...
                   leg_w_ax*pos(3), ...
                   leg_h_ax*pos(4)];
    hleg = legend(ax, {sprintf('High %s std', idx_names{i_idx}), ...
                sprintf('Low %s std',  idx_names{i_idx})}, ...
        'Box','off', 'FontSize',9, ...
        'Units','normalized', 'Position', leg_pos_fig); %#ok<NASGU>

    % ---- p 值字符串：{\it p} 只让 "p" 斜体，数值/符号保持正体 ----
    if isnan(p_ks(i_idx))
        p_str = '{\it p} = NaN';
    elseif p_ks(i_idx) < 0.05
        p_str = '{\it p} < 0.05';
    elseif p_ks(i_idx) < 0.1
        p_str = '{\it p} < 0.1';
    else
        p_str = '{\it p} > 0.1';
    end

    % ---- p 值文本：紧贴在 legend 左边界正下方 ----
    p_x = leg_x_ax;
    p_y = leg_y_ax - 0.02;
    text(ax, p_x, p_y, p_str, 'Units','normalized', ...
        'FontSize',10, 'Interpreter','tex', ...
        'HorizontalAlignment','left', 'VerticalAlignment','top');
end
exportgraphics(gcf, 'Gcausality_Var_HighLow_8idx_v1.png', 'Resolution', 600);
exportgraphics(gcf, 'Gcausality_Var_HighLow_8idx_v1.tif', 'Resolution', 600);
