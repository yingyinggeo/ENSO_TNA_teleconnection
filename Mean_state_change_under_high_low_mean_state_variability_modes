        pos((r-1)*ncol+c, 1) = xstart + (c-1)*(width + epsw);
        pos((r-1)*ncol+c, 2) = ystart_norm + (nrow-r)*(height_norm + epsh_norm);
        pos((r-1)*ncol+c, 3) = width;
        pos((r-1)*ncol+c, 4) = height_norm;
