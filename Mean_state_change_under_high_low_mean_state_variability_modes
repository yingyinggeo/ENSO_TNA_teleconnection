lon_cut = 20;
idx_R   = find(lon_orig >= lon_cut);
idx_L   = find(lon_orig <  lon_cut);
lon_pc  = [lon_orig(idx_R), lon_orig(idx_L)+360];
reorder = @(F) F(:,[idx_R, idx_L]);
%% ---- Land mask --------------------------------------------
fprintf('Building land mask...\n');
shp_path = 'C:\Users\yingy\Downloads\D\FengYingying\FengYingyingData\MapData\GLOBALSHP\ContinentsPoly.shp';
S = shaperead(shp_path, 'UseGeoCoords', true);
[LON_orig, LAT_orig] = meshgrid(lon_orig, lat_orig);
land_orig = false(size(LON_orig));
for ipoly = 1:length(S)
    px = S(ipoly).Lon(:); py = S(ipoly).Lat(:);
if isempty(px); continue; end
    nan_idx = find(isnan(px)); nan_idx = nan_idx(:);
    seg_s = [1; nan_idx+1]; seg_e = [nan_idx-1; length(px)];
for iseg = 1:length(seg_s)
        s = seg_s(iseg); e = seg_e(iseg);
if e-s < 2; continue; end
        in = inpolygon(LON_orig(:), LAT_orig(:), px(s:e), py(s:e));
        land_orig = land_orig | reshape(in, size(LON_orig));
end
end
fprintf('Land mask done.\n');
