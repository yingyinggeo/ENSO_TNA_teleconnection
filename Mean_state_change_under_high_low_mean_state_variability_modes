ncol = 2; nrow = 4;
xstart = 0.08;
epsw   = 0.06;   % 列间距（归一化）
epsh   = 0.03;   % 行间距（归一化）
% panel归一化宽度
width = (1 - xstart - 0.03 - epsw) / ncol;
% panel高度：严格按 lat_range/lon_range * (归一化宽度对应的实际度数比)
% 等距投影下，panel的高宽比 = lat_range / lon_range = 120/360
lat_range = lat_max - lat_min;   % 120
lon_range = 360;
% 实际cm宽
panel_cm_w = page_width * width;
panel_cm_h = panel_cm_w * (lat_range / lon_range);   % 严格1:3比例，保证地图不失真
% ---- 页面长宽比 1:1.5（page_height = page_width * 1.5）----
cb_area_cm   = 1.5;    % 色标区域高度(cm)
top_margin   = 1;      % 顶部标题区(cm)：标题/第一行离画布顶端的距离，保持1cm
bottom_margin= 0.8;    % 底部基础边距(cm)
% 按真实经纬度比例，8个panel+行间距+色标+上下边距实际需要多高
min_needed_height = nrow * panel_cm_h + (nrow-1) * epsh * page_width + ...
                     cb_area_cm + top_margin + bottom_margin;
page_height = page_width * 1.5;   % 目标：宽:高 = 1:1.5
% 目标高度比实际需要的多出来的空间，为了不重新出现"顶部一大块空白"的问题，
% 保持地图真实比例不变，把这部分多余空间全部放到底部（增大 bottom_margin）
extra_h       = max(page_height - min_needed_height, 0);
bottom_margin = bottom_margin + extra_h;
% 归一化高度
height_norm  = panel_cm_h / page_height;
epsh_norm    = epsh * page_width / page_height;
% 色标归一化位置
cb_h_norm    = 0.012 * page_width / page_height;
cb_bot_norm  = (bottom_margin - 0.3) / page_height;
cb_gap_norm  = 0.008;
cb_w         = width * ncol + epsw;
cb_pos       = [xstart, cb_bot_norm, cb_w, cb_h_norm];
% ystart：最下行panel底边
ystart_norm  = cb_bot_norm + cb_h_norm + cb_gap_norm * 3;
